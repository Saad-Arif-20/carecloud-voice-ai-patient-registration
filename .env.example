# Copy to .env for local development. On Railway/Render, set these as dashboard env vars
# instead of committing a .env file.

# --- Backend (FastAPI app) ---
DATABASE_PATH=./data/patients.db
LOG_FILE=./data/agent_calls.log
PORT=8000

# Shared secret Vapi must send back on every webhook call (as the x-vapi-secret header).
# Any random string works; it just has to match what you gave setup_vapi.py.
VAPI_WEBHOOK_SECRET=change-me-to-a-random-string

# --- vapi/setup_vapi.py (provisioning script only, not needed by the running app) ---
VAPI_API_KEY=
PUBLIC_API_BASE_URL=https://your-app.up.railway.app
# Vapi has a built-in Groq integration billed through your Vapi credits -- no separate
# Groq account or key needed. See https://docs.vapi.ai/providers/model/groq
VAPI_MODEL_PROVIDER=groq
VAPI_MODEL_NAME=openai/gpt-oss-120b

# Only needed if you want to swap the LLM to your own OpenAI account instead of Groq.
OPENAI_API_KEY=
